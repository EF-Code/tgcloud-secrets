# File store (local dev)
# TGCLOUD_SECRETS_DATA_DIR=.tgcloud-secrets

# Local Postgres development example (not a production credential profile)
TGCLOUD_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tgcloud
TGCLOUD_ORG_ID=myorg
TGCLOUD_PROJECT_ID=mybot
# Local KMS (in-process AES-GCM wrapping) - set a 32-byte base64url master key
# INSECURE EXAMPLE - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# TGCLOUD_MASTER_KEY=REPLACE_WITH_$(openssl rand -base64url 32)
# For AWS KMS, also set HMAC key for capability MAC (32B base64url, keep secret)
# TGCLOUD_HMAC_KEY=REPLACE_WITH_$(openssl rand -base64url 32)
# For AWS KMS, set KMS key ID and AWS credentials
# TGCLOUD_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/abc-123
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# Broker
# PORT=8787
# HOST=127.0.0.1
# TGCLOUD_TRUSTED_PROXY_ADDRESSES=10.0.0.10,10.0.0.11
# TGCLOUD_ENV=development
# TGCLOUD_BROKER_REPLICAS=1
# TGCLOUD_DISTRIBUTED_LIMITER=false
# TGCLOUD_RATE_LIMITER_MODULE=/app/config/rate-limiter-adapter.mjs  # production adapter path
# TGCLOUD_AUDIT_REQUIRED=true
# TGCLOUD_ALLOW_HTTP=true                 # loopback development only
# TGCLOUD_TLS_TERMINATED=false            # set true only behind verified TLS
# TGCLOUD_EDGE_AUTHENTICATED=false        # set true only behind auth edge
# TGCLOUD_KMS_CACHE_TTL_MS=300000       # set 0 to disable plaintext DEK caching
# TGCLOUD_KMS_CACHE_MAX_ENTRIES=1000
# TGCLOUD_KMS_OPERATION_TIMEOUT_MS=15000
# TGCLOUD_MAX_CAPABILITY_LIFETIME_MS=7776000000  # 90 days; maximum 365 days
# TGCLOUD_HMAC_KEY_ID=local-v1
# TGCLOUD_HMAC_PREVIOUS_KEYS='[{"id":"hmac-previous","key":"REPLACE_WITH_32_BYTE_BASE64URL"}]'
